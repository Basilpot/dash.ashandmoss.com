# Copy to .env.local for development, or .env.production for a deploy, and fill
# in the values. Both are gitignored. Nothing here is committed with a value.
#
# These are public hostnames, not secrets. Real secrets go in the Worker with
# `wrangler secret put` — never in an env file, because env files are the thing
# people forget to gitignore.

# Base URL of the ecommerce API, including /api/v1. Server-side only.
API_BASE_URL=

# Same value, exposed to the browser. Used only to print the copy-paste curl
# example on the API keys page, so it is inlined at build time.
NEXT_PUBLIC_API_BASE=

# Tenant used before login, when there is no store cookie yet. This database has
# exactly one store, so there is a working default in lib/env.ts if you leave
# this blank — set it explicitly once a second store exists.
DEFAULT_STORE_SLUG=

# Public site URLs, used for absolute links in emails and meta tags.
NEXT_PUBLIC_WEBSITE_DOMAIN=
NEXT_PUBLIC_FRONTEND_BASE_URL=
NEXT_PUBLIC_IMAGE_DOMAIN=
