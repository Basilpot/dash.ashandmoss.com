# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# opennext / cloudflare deploy artifacts
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
.playwright-mcp

# production build inlines, which is a public value, not a secret. Without it a
# fresh clone builds against http://localhost:3000 and the deployed dashboard
# quietly talks to nothing. Real secrets stay in `wrangler secret put`.

# .env.production holds this project's deployed hostnames. It is not committed:
# an env file is exactly where someone eventually puts a real secret, and
# tracking it is what makes that mistake easy. Keys live in .env.example.
.env.production